# Copia questo file in .env e adatta i valori.

# Porta HTTP del server
PORT=3000

# Email (separate da virgola) che ottengono l'accesso all'area amministrazione
# appena si registrano o accedono.
ADMIN_EMAILS=docente@unimi.it

# Domini email ammessi alla registrazione (separati da virgola).
ALLOWED_EMAIL_DOMAINS=studenti.unimi.it,unimi.it

# Impostare a 1 quando il sito è servito in HTTPS (consigliato in produzione).
COOKIE_SECURE=0

# Cartella in cui salvare database e video caricati.
DATA_DIR=./data
